# ─────────────────────────────────────────────────────────────
# RENAME THIS FILE TO: .env.local
# NEVER commit .env.local to GitHub!
# ─────────────────────────────────────────────────────────────

# Your Gmail address
GMAIL_USER=joshidarshan193@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# How to get it:
#   1. Go to myaccount.google.com
#   2. Security → 2-Step Verification → make sure it's ON
#   3. Security → App Passwords → Add app → "Mail" → "Other (custom)" → name it "Portfolio"
#   4. Google gives you a 16-char password like: abcd efgh ijkl mnop
#   5. Paste that here WITHOUT spaces:
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# ─────────────────────────────────────────────────────────────
# ALTERNATIVE: Use Resend (easier, free 3000 emails/month)
# Sign up at resend.com, get an API key, then:
# RESEND_API_KEY=re_xxxxxxxxxxxx
# ─────────────────────────────────────────────────────────────
